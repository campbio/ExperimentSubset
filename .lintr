linters: linters_with_defaults(
    line_length_linter = line_length_linter(80),
    # ExperimentSubset is written with 2-space indentation; keep it (see
    # AGENTS.md).
    indentation_linter = indentation_linter(indent = 2L),
    # classNames: the exported constructors (AssaySubset(), ExperimentSubset())
    # and the setClass() generators (.SubsetSummarizedExperiment, ...).
    # genericArgs: argument names that methods must take from Bioconductor
    # generics such as combineCols() and cbind().
    object_name_linter = object_name_linter(
      styles = c("camelCase", "snake_case", "symbols"),
      regexes = c(
        classNames = "^\\.?(AssaySubset|ExperimentSubset|Subset[A-Za-z]+Experiment)$",
        genericArgs = "^(use\\.names|deparse\\.level)$"
      )
    ),
    object_length_linter = NULL,
    commented_code_linter = NULL,
    return_linter = NULL,
    object_usage_linter = NULL
  )
exclusions: list(
    "renv",
    "docs",
    "man"
  )
encoding: "UTF-8"
